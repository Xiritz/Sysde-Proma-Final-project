<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller.InventoryController">
    <padding>
        <Insets top="10.0" bottom="10.0" left="10.0" right="10.0" />
    </padding>

    <Label text="Inventory Management" style="-fx-font-size: 24px; -fx-font-weight: bold blue;" />

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <!-- Inventory Forms -->
        <VBox spacing="20.0" prefWidth="300.0">
            <!-- Add New Item -->
            <VBox spacing="10.0" styleClass="card">
                <Label text="Add New Item" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                <TextField fx:id="newItemNameField" promptText="Item Name" />
                <TextField fx:id="newStockField" promptText="Initial Stock" />
                <TextField fx:id="newThresholdField" promptText="Low Stock Threshold" />
                <Button text="Add Item" onAction="#handleAddItem" maxWidth="Infinity" styleClass="success-button" />
            </VBox>

            <!-- Update Stock -->
            <VBox spacing="10.0" styleClass="card">
                <Label text="Stock Adjustment" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                <ComboBox fx:id="itemComboBox" promptText="Select Item" maxWidth="Infinity" />
                <TextField fx:id="adjustmentQuantityField" promptText="Quantity" />
                <HBox spacing="10.0">
                    <Button text="Restock" onAction="#handleRestock" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="primary-button" />
                    <Button text="Consume" onAction="#handleConsume" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="primary-button" />
                </HBox>
            </VBox>
        </VBox>

        <!-- Inventory List -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="card">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Inventory List" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lowStockAlertLabel" text="Low stock items detected!" style="-fx-text-fill: #e67e22; -fx-font-weight: bold;" visible="false" />
            </HBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <VBox fx:id="cardsContainer" spacing="10.0" style="-fx-padding: 5;">
                    <!-- Cards will be injected here -->
                </VBox>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>
