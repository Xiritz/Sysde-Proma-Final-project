<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller.CustomerController">
    <padding>
        <Insets top="10.0" bottom="10.0" left="10.0" right="10.0" />
    </padding>

    <Label text="Customer Management" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <!-- Customer Form -->
        <VBox spacing="15.0" styleClass="card" prefWidth="300.0">
            <Label text="Register New Customer" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <VBox spacing="5.0">
                <Label text="Full Name" />
                <TextField fx:id="nameField" promptText="Enter name" />
            </VBox>
            <VBox spacing="5.0">
                <Label text="Address" />
                <TextArea fx:id="addressField" promptText="Enter address" prefHeight="80.0" />
            </VBox>
            <VBox spacing="5.0">
                <Label text="Contact Number" />
                <TextField fx:id="contactField" promptText="Enter contact number" />
            </VBox>
            <Button text="Register Customer" onAction="#handleRegister" maxWidth="Infinity" styleClass="success-button" />
            <Button text="Clear" onAction="#handleClear" maxWidth="Infinity" styleClass="secondary-button" />
        </VBox>

        <!-- Customer List -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="card">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Customer List" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" promptText="Search customers..." prefWidth="250.0" />
            </HBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <VBox fx:id="cardsContainer" spacing="10.0" style="-fx-padding: 5;">
                    <!-- Cards will be injected here -->
                </VBox>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>
