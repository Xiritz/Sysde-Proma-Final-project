<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #2c3e50;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller.LoginController">
    <VBox alignment="CENTER" maxWidth="400.0" spacing="30.0" styleClass="card" style="-fx-padding: 40;">
        <Label text="LAUNDRY POS" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
        
        <VBox spacing="20.0" maxWidth="300.0">
            <VBox spacing="8.0">
                <Label text="Username" style="-fx-font-weight: bold;" />
                <TextField fx:id="usernameField" promptText="Enter your username" />
            </VBox>
            
            <VBox spacing="8.0">
                <Label text="Password" style="-fx-font-weight: bold;" />
                <PasswordField fx:id="passwordField" promptText="Enter your password" />
            </VBox>
        </VBox>

        <Label fx:id="errorLabel" textFill="#e74c3c" wrapText="true" alignment="CENTER" />

        <Button onAction="#handleLogin" text="Sign In" styleClass="primary-button" maxWidth="300.0" prefHeight="45.0" />
    </VBox>
</VBox>
