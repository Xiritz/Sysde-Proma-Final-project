<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller.StaffController">
    <padding>
        <Insets top="10.0" bottom="10.0" left="10.0" right="10.0" />
    </padding>

    <Label text="Staff Management" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <!-- Staff Form -->
        <VBox spacing="15.0" styleClass="card" prefWidth="300.0">
            <Label text="Add New Staff" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            
            <VBox spacing="5.0">
                <Label text="Username" />
                <TextField fx:id="usernameField" promptText="Enter username" />
            </VBox>
            
            <VBox spacing="5.0">
                <Label text="Password" />
                <PasswordField fx:id="passwordField" promptText="Enter password" />
            </VBox>
            
            <VBox spacing="5.0">
                <Label text="Role" />
                <ComboBox fx:id="roleComboBox" promptText="Select Role" maxWidth="Infinity" />
            </VBox>
            
            <Button text="Add Staff Member" onAction="#handleAddStaff" maxWidth="Infinity" style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
            <Button text="Clear" onAction="#handleClear" maxWidth="Infinity" />
        </VBox>

        <!-- Staff List -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="card">
            <Label text="Staff List" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <VBox fx:id="cardsContainer" spacing="10.0" style="-fx-padding: 5;">
                    <!-- Cards will be injected here -->
                </VBox>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>
