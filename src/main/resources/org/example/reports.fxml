<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller.ReportController">
    <padding>
        <Insets top="10.0" bottom="10.0" left="10.0" right="10.0" />
    </padding>

    <Label text="Financial Reports" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <!-- Range Selector -->
    <HBox spacing="15.0" styleClass="card" alignment="CENTER_LEFT">
        <Label text="Report Range:" />
        <ComboBox fx:id="rangeComboBox" promptText="Select Range" />
        <DatePicker fx:id="startDatePicker" promptText="Start Date" disable="true" />
        <DatePicker fx:id="endDatePicker" promptText="End Date" disable="true" />
        <Button text="Generate Report" onAction="#handleGenerateReport" styleClass="primary-button" />
        <Button text="Export to PDF" onAction="#handleExportPDF" styleClass="secondary-button" />
    </HBox>

    <!-- Summary Cards -->
    <HBox spacing="20.0">
        <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <Label text="Total Revenue" styleClass="card-title" />
            <Label fx:id="revenueLabel" text="Php 0.00" styleClass="card-value" style="-fx-text-fill: #27ae60;" />
        </VBox>
        <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <Label text="Total Expenses" styleClass="card-title" />
            <Label fx:id="expenseLabel" text="Php 0.00" styleClass="card-value" style="-fx-text-fill: #c0392b;" />
        </VBox>
        <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <Label text="Net Profit" styleClass="card-title" />
            <Label fx:id="profitLabel" text="Php 0.00" styleClass="card-value" style="-fx-text-fill: #2980b9;" />
        </VBox>
    </HBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <!-- Add Expense Form -->
        <VBox spacing="15.0" styleClass="card" prefWidth="300.0">
            <Label text="Record Expense" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <VBox spacing="5.0">
                <Label text="Expense Name" />
                <TextField fx:id="expenseNameField" promptText="e.g. Detergent" />
            </VBox>
            <VBox spacing="5.0">
                <Label text="Cost" />
                <TextField fx:id="expenseCostField" promptText="0.00" />
            </VBox>
            <Button text="Add Expense" onAction="#handleAddExpense" maxWidth="Infinity" styleClass="primary-button" />
        </VBox>

        <!-- Expense Breakdown -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="card">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Expense Breakdown" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" promptText="Search expenses..." prefWidth="200.0" />
            </HBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <VBox fx:id="cardsContainer" spacing="10.0" style="-fx-padding: 5;">
                    <!-- Cards will be injected here -->
                </VBox>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>
